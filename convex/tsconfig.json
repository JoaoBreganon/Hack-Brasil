{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ES2021", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["node", "vite/client"]
	},
	"include": ["./**/*"],
	"exclude": ["./_generated"]
}
