{
	"name": "aloca",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"dev": "pnpm --filter web dev",
		"build": "pnpm --filter web build",
		"lint": "pnpm -r lint",
		"typecheck": "pnpm -r typecheck && tsc -p convex --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"convex:dev": "convex dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"convex:limpar": "node scripts/limpar-gerados.mjs && prettier --write convex/_generated"
	},
	"dependencies": {
		"convex": "^1.50.0"
	},
	"devDependencies": {
		"prettier": "^3.10.1",
		"typescript": "^5.9.3",
		"vitest": "^5.1.0"
	}
}
