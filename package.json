{
	"name": "aloca",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"dev": "pnpm --filter web dev",
		"build": "pnpm --filter web build",
		"lint": "pnpm -r lint",
		"typecheck": "pnpm -r typecheck && tsc -p convex --noEmit && tsc -p e2e --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"convex:dev": "convex dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"convex:limpar": "node scripts/limpar-gerados.mjs && prettier --write convex/_generated"
	},
	"dependencies": {
		"@aloca/dominio": "workspace:*",
		"convex": "^1.50.0"
	},
	"devDependencies": {
		"@edge-runtime/vm": "^5.0.0",
		"@playwright/test": "1.65.1",
		"@types/node": "^20.19.43",
		"convex-test": "^0.0.72",
		"prettier": "^3.10.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
